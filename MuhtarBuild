#!/usr/bin/env bash
set -euo pipefail

# Keep paths predictable even when launched from a different working directory.
ROOT="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
PROJECT="$ROOT/muhtar_minigame"
FLUTTER="${FLUTTER_BIN:-flutter}"
TARGET="${MUHTAR_BUILD_TARGET:-lib/muhtar_build.dart}"
IS_FEDORA=0
if [ -r /etc/os-release ]; then
  . /etc/os-release
  case "${ID:-}:${ID_LIKE:-}" in
    fedora:*|*":*fedora"*|rhel:*|centos:*|rocky:*|almalinux:*)
      IS_FEDORA=1
      ;;
  esac
fi
if ! command -v "$FLUTTER" >/dev/null 2>&1; then
  printf '%s\n' 'Flutter не найден. Добавьте flutter в PATH или задайте FLUTTER_BIN=/путь/к/flutter.' >&2
  exit 1
fi

# Fedora uses /usr/lib64/pkgconfig. A stale PKG_CONFIG_PATH copied from a
# Debian/Ubuntu environment can make CMake import the non-existent
# /usr/lib/x86_64-linux-gnu/glib-2.0/include directory. Keep this override
# local to MuhtarBuild; the user's shell environment is not changed.
if [ "$IS_FEDORA" -eq 1 ]; then
  export PKG_CONFIG_LIBDIR="/usr/lib64/pkgconfig:/usr/share/pkgconfig:/usr/lib/pkgconfig"
  unset PKG_CONFIG_PATH
fi

# If the OS/toolchain changed since the previous run, CMake may still contain
# the old absolute include directory. Remove only the generated Flutter build
# cache; source files, drafts, and assets are not touched.
CMAKE_CACHE="$PROJECT/build/linux/x64/debug/CMakeCache.txt"
if [ -f "$CMAKE_CACHE" ]; then
  stale_cache=0
  while IFS= read -r cache_line; do
    case "$cache_line" in
      *"/usr/lib/x86_64-linux-gnu/glib-2.0/include"*)
        if [ ! -d "/usr/lib/x86_64-linux-gnu/glib-2.0/include" ]; then
          stale_cache=1
        fi
        ;;
    esac
  done < "$CMAKE_CACHE"
  if [ "$stale_cache" -eq 1 ]; then
    printf '%s\n' 'Старый CMake-кэш GTK/GLib найден. Очищаю только Flutter build cache...' >&2
    (cd "$PROJECT" && "$FLUTTER" clean)
  fi
fi

# Flutter's Linux runner and audioplayers_linux both use GTK/GLib. Fail before
# CMake with the actual missing directory instead of an opaque imported-target
# error several screens later.
if ! command -v pkg-config >/dev/null 2>&1; then
  printf '%s\n' 'pkg-config не найден. Установите GTK/GLib development packages.' >&2
  if [ "$IS_FEDORA" -eq 1 ]; then
    printf '%s\n' '  sudo dnf install pkgconf-pkg-config gtk3-devel glib2-devel' >&2
  elif command -v apt-get >/dev/null 2>&1; then
    printf '%s\n' '  sudo apt-get update && sudo apt-get install pkg-config libgtk-3-dev libglib2.0-dev' >&2
  fi
  exit 1
fi

if ! pkg-config --exists gtk+-3.0; then
  printf '%s\n' 'GTK 3 development files are not visible to pkg-config.' >&2
  if [ "$IS_FEDORA" -eq 1 ]; then
    printf '%s\n' 'On Fedora run:' >&2
    printf '%s\n' '  sudo dnf install clang cmake ninja-build pkgconf-pkg-config gtk3-devel glib2-devel' >&2
  elif command -v apt-get >/dev/null 2>&1; then
    printf '%s\n' 'On Debian/Ubuntu run:' >&2
    printf '%s\n' '  sudo apt-get update && sudo apt-get install --reinstall clang cmake ninja-build pkg-config libgtk-3-dev libglib2.0-dev' >&2
  else
    printf '%s\n' 'Install the GTK 3 and GLib development packages for your Linux distribution.' >&2
  fi
  printf '%s\n' 'Then run: flutter clean && ./MuhtarBuild' >&2
  exit 1
fi

if pkg-config --exists gtk+-3.0; then
  for flag in $(pkg-config --cflags gtk+-3.0); do
    case "$flag" in
      -I*)
        include_dir="${flag#-I}"
        if [ ! -d "$include_dir" ]; then
          printf 'GTK/GLib development headers are incomplete: missing %s\n' "$include_dir" >&2
          if [ "$IS_FEDORA" -eq 1 ]; then
            printf '%s\n' 'On Fedora run:' >&2
            printf '%s\n' '  sudo dnf reinstall glib2-devel gtk3-devel && sudo dnf install clang cmake ninja-build pkgconf-pkg-config' >&2
          elif command -v apt-get >/dev/null 2>&1; then
            printf '%s\n' 'On Debian/Ubuntu run:' >&2
            printf '%s\n' '  sudo apt-get update && sudo apt-get install --reinstall libglib2.0-dev libgtk-3-dev pkg-config' >&2
          else
            printf '%s\n' 'Reinstall the GTK 3 and GLib development packages for your Linux distribution.' >&2
          fi
          printf '%s\n' 'Then run: flutter clean && ./MuhtarBuild' >&2
          exit 1
        fi
        ;;
    esac
  done
fi
cd "$PROJECT"
export MUHTAR_BUILD=1
exec "$FLUTTER" run -d "${MUHTAR_BUILD_DEVICE:-linux}" -t "$TARGET" "$@"
